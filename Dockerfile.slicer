# syntax=docker/dockerfile:1.7
ARG DEPS_IMAGE=deps
ARG ENGINE_IMAGE=engine
FROM ubuntu:24.04 AS toolchain
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build ccache clang lld autoconf automake libtool \
    pkg-config git curl ca-certificates gettext texinfo python3 python3-dev python3-venv \
    libssl-dev libcurl4-openssl-dev libpng-dev libjpeg-dev libexpat1-dev zlib1g-dev \
    libgtk-3-dev libglu1-mesa-dev libsecret-1-dev libx11-dev libxrandr-dev libxinerama-dev \
    libxcursor-dev libxi-dev libwayland-dev libxkbcommon-dev nasm bison flex \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
ENV CMAKE_BUILD_PARALLEL_LEVEL=2 CCACHE_DIR=/compiler-cache

FROM toolchain AS deps
ARG BUILD_JOBS=2
ARG DEPS_CACHE_KEY=v019-headless-clang-amd64
# A source or wrapper change must not invalidate this layer.
COPY deps/ deps/
COPY cmake/ cmake/
COPY scripts/fleet_build_progress.py /usr/local/bin/fleet-build-progress
RUN --mount=type=cache,target=/compiler-cache --mount=type=cache,target=/src/deps/build,id=unlayered-${DEPS_CACHE_KEY} \
    --mount=type=cache,target=/src/deps/DL_CACHE,id=unlayered-downloads \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} cmake -S deps -B deps/build -G Ninja -DSLIC3R_CAD=OFF -DFLEET_HEADLESS=ON \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    && CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS} python3 /usr/local/bin/fleet-build-progress \
      --label dependencies --log /src/deps/build/fleet-build.log --objects /src/deps/build \
      -- cmake --build deps/build -j1 \
    && cp -a deps/build/OrcaSlicer_dep /opt/unlayered-deps

FROM ${DEPS_IMAGE} AS engine
ARG BUILD_JOBS=2
RUN mkdir -p /src/deps/build && ln -s /opt/unlayered-deps /src/deps/build/OrcaSlicer_dep
COPY CMakeLists.txt version.inc LICENSE.txt ./
COPY src/ src/
COPY deps_src/ deps_src/
COPY resources/ resources/
COPY localization/ localization/
COPY scripts/ scripts/
COPY tests/ tests/
COPY tools/ tools/
COPY scripts/fleet_build_progress.py /usr/local/bin/fleet-build-progress
RUN --mount=type=cache,target=/compiler-cache \
    cmake -S . -B build -G Ninja -DFLEET_HEADLESS=ON -DSLIC3R_GUI=OFF -DSLIC3R_CAD=OFF \
      -DORCA_BUILD_PYTHON_STUBGEN_MODULE=OFF -DSLIC3R_PCH=OFF -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_PREFIX_PATH=/src/deps/build/OrcaSlicer_dep/usr/local \
      -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++ \
      -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
    && python3 /usr/local/bin/fleet-build-progress \
      --label engine --log build/fleet-engine.log --objects build \
      -- cmake --build build --target UnlayeredSlicer FleetSlicerTests -j${BUILD_JOBS} \
    && LD_LIBRARY_PATH=/src/deps/build/OrcaSlicer_dep/usr/local/libpython/lib ./build/src/FleetSlicerTests \
    && mkdir -p /opt/unlayered/bin /opt/unlayered/lib \
    && cp build/src/unlayered-slicer /opt/unlayered/bin/ \
    && cp -a resources /opt/unlayered/ \
    && cp LICENSE.txt /opt/unlayered/ \
    && cp -a deps/build/OrcaSlicer_dep/usr/local/libpython /opt/unlayered/python \
    && find deps/build/OrcaSlicer_dep/usr/local/lib -maxdepth 1 -name '*.so*' -exec cp -a '{}' /opt/unlayered/lib/ ';'

FROM ${ENGINE_IMAGE} AS tested
COPY slicer_service/ /acceptance/
RUN UNLAYERED_BIN=/opt/unlayered/bin/unlayered-slicer LD_LIBRARY_PATH=/opt/unlayered/lib:/opt/unlayered/python/lib \
    python3 /acceptance/acceptance.py /opt/unlayered/acceptance.json

FROM ubuntu:24.04 AS runtime
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PORT=8090 LD_LIBRARY_PATH=/opt/unlayered/lib:/opt/unlayered/python/lib
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 python3-aiohttp \
    libcurl4t64 libssl3t64 libgomp1 libpangoft2-1.0-0 libglu1-mesa libgl1 libsecret-1-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=tested /opt/unlayered /opt/unlayered
COPY slicer_service/ /app/
RUN useradd -m -u 10001 slicer && mkdir /work && chown slicer:slicer /work
USER slicer
WORKDIR /app
EXPOSE 8090
ARG SOURCE_REVISION=unpublished
ENV SOURCE_REVISION=${SOURCE_REVISION}
LABEL org.opencontainers.image.source="https://github.com/Modovolo/Unlayered-Slicer" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0"
CMD ["python3", "/app/app.py"]
